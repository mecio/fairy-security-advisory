"""Bootstrap and launch fAIry Security Advisory."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
MANAGER = ROOT / "scripts/manage.py"
REQUIREMENTS = ROOT / "requirements.txt"
GUI_REQUIREMENTS = ROOT / "desktop/requirements.txt"
VENV = ROOT / ".venv"


def venv_python() -> Path:
    if os.name == "nt":
        return VENV / "Scripts/python.exe"
    return VENV / "bin/python"


def has_runtime_dependencies(python: Path) -> bool:
    result = subprocess.run(
        [str(python), "-c", "import yaml"],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def has_gui_dependencies(python: Path) -> bool:
    result = subprocess.run(
        [str(python), "-c", "import PySide6"],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def confirm(prompt: str) -> bool:
    if not sys.stdin.isatty():
        return False
    return input(f"{prompt} [y/N]: ").strip().lower() in {"y", "yes"}


def install_environment(*, assume_yes: bool = False, include_gui: bool = False) -> Path | None:
    python = venv_python()
    requirement_files = [REQUIREMENTS, *([GUI_REQUIREMENTS] if include_gui else [])]
    names = ", ".join(str(path.relative_to(ROOT)) for path in requirement_files)
    print("The project Python environment is missing or incomplete.")
    if not assume_yes and not confirm(f"Create/update .venv and install {names} now?"):
        print("Run this launcher again in an interactive terminal to complete setup.")
        return None
    if not python.exists():
        result = subprocess.run(
            [sys.executable, "-m", "venv", str(VENV)], cwd=ROOT, check=False,
        )
        if result.returncode != 0:
            return None
    for requirements in requirement_files:
        result = subprocess.run(
            [str(python), "-m", "pip", "install", "-r", str(requirements)],
            cwd=ROOT,
            check=False,
        )
        if result.returncode != 0:
            return None
    ready = has_runtime_dependencies(python) and (not include_gui or has_gui_dependencies(python))
    return python if ready else None


def main() -> int:
    if sys.version_info < (3, 11):
        print("Python 3.11 or later is required.", file=sys.stderr)
        return 1

    arguments = list(sys.argv[1:])
    gui_requested = "--gui" in arguments or (
        "--action" in arguments and arguments[arguments.index("--action") + 1:][:1] == ["gui"]
    )
    if "--gui" in arguments:
        arguments.remove("--gui")
        if "--action" not in arguments:
            arguments[0:0] = ["--action", "gui"]

    current_python = Path(sys.executable)
    project_python = venv_python()
    if project_python.exists() and has_runtime_dependencies(project_python):
        selected_python = project_python
    elif has_runtime_dependencies(current_python):
        selected_python = current_python
    else:
        selected_python = install_environment(assume_yes="--yes" in arguments)
        if selected_python is None:
            return 1

    if gui_requested and not has_gui_dependencies(selected_python):
        selected_python = install_environment(
            assume_yes="--yes" in arguments, include_gui=True,
        )
        if selected_python is None:
            return 1

    os.execv(
        str(selected_python),
        [str(selected_python), str(MANAGER), *arguments],
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
